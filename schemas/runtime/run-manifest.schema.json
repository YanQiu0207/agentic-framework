{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://agentic-engineering-framework.local/schemas/runtime/run-manifest.schema.json",
    "title": "run-manifest",
    "allOf": [
        {
            "$ref": "https://agentic-engineering-framework.local/schemas/runtime/run-envelope.schema.json"
        },
        {
            "properties": {
                "artifact_type": {
                    "const": "run-manifest"
                },
                "payload": {
                    "type": "object",
                    "required": [
                        "base_commit_sha",
                        "artifacts",
                        "tasks",
                        "relations"
                    ],
                    "properties": {
                        "base_commit_sha": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{40}$"
                        },
                        "artifacts": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "required": [
                                    "artifact_id",
                                    "path",
                                    "artifact_type",
                                    "content_digest",
                                    "producer",
                                    "schema_version"
                                ],
                                "properties": {
                                    "artifact_id": {
                                        "type": "string",
                                        "minLength": 1
                                    },
                                    "path": {
                                        "type": "string",
                                        "minLength": 1
                                    },
                                    "artifact_type": {
                                        "type": "string",
                                        "minLength": 1
                                    },
                                    "content_digest": {
                                        "type": "string",
                                        "pattern": "^sha256:[0-9a-f]{64}$"
                                    },
                                    "producer": {
                                        "type": "string",
                                        "minLength": 1
                                    },
                                    "schema_version": {
                                        "type": "integer",
                                        "minimum": 1
                                    }
                                },
                                "additionalProperties": false
                            }
                        },
                        "tasks": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "required": [
                                    "task_id",
                                    "attempt",
                                    "state",
                                    "artifact_ids"
                                ],
                                "properties": {
                                    "task_id": {
                                        "type": "string",
                                        "minLength": 1
                                    },
                                    "attempt": {
                                        "type": "integer",
                                        "minimum": 1
                                    },
                                    "state": {
                                        "enum": [
                                            "pending",
                                            "running",
                                            "quality_passed",
                                            "completed",
                                            "manual",
                                            "blocked"
                                        ]
                                    },
                                    "artifact_ids": {
                                        "type": "array",
                                        "items": {
                                            "type": "string",
                                            "minLength": 1
                                        },
                                        "uniqueItems": true
                                    }
                                },
                                "additionalProperties": false
                            }
                        },
                        "relations": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "required": [
                                    "relation_type",
                                    "source_artifact_id",
                                    "target_artifact_id"
                                ],
                                "properties": {
                                    "relation_type": {
                                        "enum": [
                                            "produced_by",
                                            "consumes",
                                            "verifies",
                                            "reviews",
                                            "concludes",
                                            "supersedes"
                                        ]
                                    },
                                    "source_artifact_id": {
                                        "type": "string",
                                        "minLength": 1
                                    },
                                    "target_artifact_id": {
                                        "type": "string",
                                        "minLength": 1
                                    }
                                },
                                "additionalProperties": false
                            }
                        }
                    },
                    "additionalProperties": false
                },
                "task_id": {
                    "type": "null"
                },
                "attempt": {
                    "type": "null"
                }
            }
        }
    ]
}
