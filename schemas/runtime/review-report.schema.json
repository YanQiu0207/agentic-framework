{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://agentic-engineering-framework.local/schemas/runtime/review-report.schema.json",
    "title": "review-report",
    "allOf": [
        {
            "$ref": "https://agentic-engineering-framework.local/schemas/runtime/run-envelope.schema.json"
        },
        {
            "properties": {
                "artifact_type": {
                    "const": "review-report"
                },
                "payload": {
                    "type": "object",
                    "required": [
                        "verdict",
                        "p0_count",
                        "p1_count",
                        "scope",
                        "review_profile",
                        "round"
                    ],
                    "properties": {
                        "verdict": {
                            "enum": [
                                "PASS",
                                "NEEDS_CHANGES"
                            ]
                        },
                        "p0_count": {
                            "type": "integer",
                            "minimum": 0
                        },
                        "p1_count": {
                            "type": "integer",
                            "minimum": 0
                        },
                        "scope": {
                            "enum": [
                                "task",
                                "integration"
                            ]
                        },
                        "review_profile": {
                            "enum": [
                                "lightweight",
                                "standard",
                                "strict"
                            ]
                        },
                        "round": {
                            "type": "integer",
                            "minimum": 0
                        },
                        "findings": {
                            "type": "array",
                            "items": {
                                "type": "object"
                            }
                        }
                    },
                    "additionalProperties": false
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "payload": {
                                "properties": {
                                    "scope": {
                                        "const": "task"
                                    }
                                },
                                "required": [
                                    "scope"
                                ]
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "task_id": {
                                "type": "string",
                                "minLength": 1
                            },
                            "attempt": {
                                "type": "integer",
                                "minimum": 1
                            }
                        }
                    },
                    "else": {
                        "properties": {
                            "task_id": {
                                "type": "null"
                            },
                            "attempt": {
                                "type": "null"
                            }
                        }
                    }
                }
            ]
        }
    ]
}
