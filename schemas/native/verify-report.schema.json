{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-framework.local/native/verify-report/v2",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "subject_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "ERROR"
      ]
    },
    "total": {
      "type": "integer",
      "minimum": 1
    },
    "errors": {
      "type": "integer",
      "minimum": 0
    },
    "violations": {
      "type": "integer",
      "minimum": 0
    },
    "spec_drift": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "error"
          ]
        },
        "detail": {
          "type": "string"
        },
        "value": {},
        "new_items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "name",
        "type",
        "status",
        "detail",
        "value",
        "new_items"
      ],
      "additionalProperties": false
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "error"
            ]
          },
          "detail": {
            "type": "string"
          },
          "value": {},
          "new_items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name",
          "type",
          "status",
          "detail",
          "value",
          "new_items"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "subject_id",
    "verdict",
    "total",
    "errors",
    "violations",
    "spec_drift",
    "warnings",
    "results"
  ],
  "additionalProperties": false
}
